{
  "name": "digs-storefront",
  "private": true,
  "sideEffects": false,
  "version": "0.1.0",
  "type": "module",
  "description": "digs (dopeisgood.com): custom Shopify Hydrogen storefront. Phase: wireframes, UI and components on mock data.",
  "scripts": {
    "dev": "shopify hydrogen dev --port 3000",
    "build": "rm -rf dist && shopify hydrogen build",
    "preview": "shopify hydrogen preview --build --port 3000",
    "preview:built": "shopify hydrogen preview --port 3000",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern app tests tools/*.ts",
    "check:brand": "python3 tools/check_brand.py",
    "test:visual": "playwright test --config tests/visual/playwright.config.ts",
    "test:visual:update": "playwright test --config tests/visual/playwright.config.ts --update-snapshots",
    "test:a11y": "playwright test --config tests/visual/playwright.config.ts --grep @a11y",
    "test:keyboard": "playwright test --config tests/visual/playwright.config.ts --grep @keyboard",
    "shots:wireframes": "playwright test --config tests/visual/playwright.config.ts --grep @wireframes",
    "shots:ui": "playwright test --config tests/visual/playwright.config.ts --grep @ui-shots",
    "tokens": "python3 tools/build_tokens.py",
    "fonts": "python3 tools/build_fonts.py",
    "brand:svg": "python3 tools/brand_svg.py",
    "photos:sync": "python3 tools/photo_sync.py"
  },
  "prettier": "@shopify/prettier-config",
  "dependencies": {
    "@shopify/hydrogen": "2026.4.7",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "isbot": "^5.1.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.16.0",
    "react-router-dom": "7.16.0",
    "tailwindcss": "^4.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "1.56.1",
    "@react-router/dev": "7.16.0",
    "@react-router/fs-routes": "7.16.0",
    "@shopify/cli": "3.93.2",
    "@shopify/mini-oxygen": "4.2.3",
    "@shopify/oxygen-workers-types": "^4.1.6",
    "@shopify/prettier-config": "^1.1.2",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.1.6",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-storybook": "^10.6.2",
    "globals": "^15.14.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.4.2",
    "storybook": "^10.6.2",
    "svgo": "^4.1.0",
    "typescript": "^5.9.2",
    "vite": "^8.0.1"
  },
  "engines": {
    "node": "^22 || ^24"
  },
  "browserslist": [
    "defaults"
  ]
}
